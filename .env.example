# Copy this file to `.env.local` and fill in the values. `.env.local` is never committed.
# In Vercel: Project → Settings → Environment Variables (Production and Preview).

# Supabase (Project Settings → API Keys). Safe in the browser: the database's RLS rules protect the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SECRET: full database access, bypasses all rules. Only for `npm run admin:add` on this computer.
# Never add it to Vercel and never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...
# Database password, only for `npx supabase db push` on this computer.
SUPABASE_DB_PASSWORD=

# The live site address (used for SEO links and the Open Graph image). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://sb-studio.vercel.app

# Optional: booking emails through Resend (resend.com). Leave RESEND_API_KEY empty to send no emails.
RESEND_API_KEY=
# Sender, on a domain verified in Resend. Leave empty to use Resend's test sender (only delivers to your own Resend email).
RESEND_FROM="SB Studio <bookings@your-domain.com>"
# Where "new booking" emails go (Shlomo's email). Leave empty to skip.
BOOKING_NOTIFY_EMAIL=
